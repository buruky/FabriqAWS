# Anything prefixed VITE_ is inlined into the client bundle at build time and
# is visible to anyone who opens devtools. Never put secrets here — API keys,
# service credentials, etc. belong server-side (Lambda env config / Secrets
# Manager), not in this file. See FRONTEND_REBUILD_SPEC.md #2.2.3.

# Base URL of the backend API once it exists (API Gateway, etc.) — a URL is
# not a secret, so this one is safe to expose.
VITE_API_BASE_URL=
